    "@tauri-apps/plugin-updater": "^2.10.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.20.5",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vitest": "^3.2.4"
  }
}
