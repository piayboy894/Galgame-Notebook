{
  "name": "xuxian-desktop",
  "version": "2.10.0",
  "private": true,
  "type": "module",
  "description": "叙线 · 离线 AVG 剧本编辑器",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "node scripts/smoke.mjs",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "android:build": "tauri android build --apk --target aarch64 x86_64",
    "version:sync": "node scripts/sync-version.mjs",
    "release:publish": "node scripts/publish-release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
